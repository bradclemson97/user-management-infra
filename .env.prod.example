# ── Required secrets for docker-compose.prod.yml ─────────────────────────────
# Copy to .env and fill in before running: cp .env.example .env

# Postgres
POSTGRES_PASSWORD=

# Keycloak admin credentials (used to bootstrap realm setup)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Secret for the system-manager-service Keycloak client (Clients → Credentials)
KEYCLOAK_MANAGER_SECRET=

# Secret for the user-management-ui Keycloak client (Clients → Credentials)
KEYCLOAK_CLIENT_SECRET=

# Express session encryption key — generate with: openssl rand -hex 32
SESSION_SECRET=
