# Copy this file to .env.prod and fill in the values before deploying.
# NEVER commit .env.prod to git.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# Keycloak admin credentials (used on first boot to create the admin user)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password

# Keycloak client secret for the system-manager-service client (set in Keycloak admin after first boot)
KEYCLOAK_MANAGER_SECRET=change-me-client-secret

# Keycloak client secret for the user-management-ui client (set in Keycloak admin after first boot)
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# Express session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-session-secret
